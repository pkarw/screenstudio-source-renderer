{
  "name": "screenstudio-source-renderer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TypeScript CLI for rendering Screen Studio projects with zooms, camera, cursor, backgrounds, subtitles and ETA progress.",
  "bin": {
    "ss-render": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
